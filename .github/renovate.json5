{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
  ],
  // Conventional Commits drive release-please: "fix" releases, "chore" only lands in the changelog.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  // Keep go.mod/go.sum tidy so Go PRs pass the drift check in test.yml.
  postUpdateOptions: ["gomodTidy"],
  customManagers: [
    {
      // Makefile tool versions annotated with "# renovate: datasource=... depName=...".
      // Re-check these annotations after every Operator SDK re-scaffold.
      customType: "regex",
      managerFilePatterns: ["/^Makefile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\S+ \\?= (?<currentValue>\\S+)",
      ],
    },
    {
      // golangci-lint version used by golangci-lint-action; kept in step with the Makefile.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/lint\\.yml$/"],
      matchStrings: ["version: (?<currentValue>v\\S+)"],
      datasourceTemplate: "go",
      depNameTemplate: "github.com/golangci/golangci-lint/v2",
    },
  ],
  // Order matters: later rules override earlier ones.
  packageRules: [
    {
      description: "Majors need Dependency Dashboard approval",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Operator SDK scaffold tools are upgraded manually",
      matchPackageNames: [
        "operator-framework/operator-sdk",
        "operator-framework/operator-registry",
      ],
      dependencyDashboardApproval: true,
    },
    {
      description: "Kubernetes stack moves as one unit; k8s.io/utils uses pseudo-versions and would block the group",
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "!k8s.io/utils",
      ],
      groupName: "kubernetes stack",
    },
    {
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "!k8s.io/utils",
      ],
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "!k8s.io/utils",
      ],
      matchUpdateTypes: ["minor"],
      dependencyDashboardApproval: true,
    },
    {
      description: "go directive and golang builder image move together; digests stay out of the group",
      matchDepNames: ["go", "golang"],
      matchUpdateTypes: ["major", "minor", "patch"],
      groupName: "go toolchain",
      automerge: false,
    },
    {
      description: "Renovate leaves the go directive alone by default; bump keeps it in step with golang",
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      description: "Do not bump the go directive for Go patch releases",
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchUpdateTypes: ["patch"],
      enabled: false,
    },
    {
      description: "golangci-lint in Makefile and lint.yml in one PR",
      matchPackageNames: ["github.com/golangci/golangci-lint/v2"],
      groupName: "golangci-lint",
      automerge: true,
    },
    {
      description: "The github-actions manager also reads the action's version input; the lint.yml regex manager owns it",
      matchManagers: ["github-actions"],
      matchDepNames: ["golangci/golangci-lint"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["digest", "pinDigest"],
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      matchPackageNames: ["github.com/onsi/**"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Go modules and Dockerfile images ship in the operator image, so they trigger a release",
      matchManagers: ["gomod", "dockerfile"],
      semanticCommitType: "fix",
    },
    {
      description: "Test-only modules don't ship in the image",
      matchPackageNames: ["github.com/onsi/**"],
      semanticCommitType: "chore",
    },
  ],
}
